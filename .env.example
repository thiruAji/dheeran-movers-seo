# Add your public production origin, for example https://www.example.com
VITE_SITE_URL=https://www.your-domain.sg
# Digits only, Singapore country code included. Example format: 6581234567
VITE_WHATSAPP_NUMBER=
# Example: +65 8123 4567
VITE_PHONE_NUMBER=
# Optional GA4 measurement ID, e.g. G-XXXXXXXXXX
VITE_GA_ID=
# Optional form endpoint (Formspree, Getform, or your own API). If blank, quote form opens WhatsApp.
VITE_QUOTE_ENDPOINT=
